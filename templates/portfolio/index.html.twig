{% extends 'base.html.twig' %}

{% block title %}Portfolio — Adrien Mihajlovic{% endblock %}

{% block body %}

{# Hero #}
<section class="pt-40 pb-20 border-b" style="background-color: #0a0a0a; border-color: rgba(255,255,255,0.06);">
    <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row md:items-end justify-between gap-8">
        <div>
            <span class="section-label">Travaux</span>
            <h1 class="font-serif font-light text-white" style="font-size: clamp(2.5rem, 6vw, 5rem); line-height: 1.05;">
                Portfolio
            </h1>
        </div>
        <p class="text-sm max-w-xs" style="color: #6b7280;">
            Du portrait intimiste aux campagnes commerciales internationales — une sélection de mes meilleurs travaux.
        </p>
    </div>
</section>

{# Filtres + Grille #}
<section class="py-16" style="background-color: #0a0a0a;" data-controller="portfolio-filter">

    {# Filtres #}
    <div class="max-w-7xl mx-auto px-6 mb-12">
        <div class="flex flex-wrap gap-6" role="group" aria-label="Filtrer par catégorie">
            {% for label, filter in {'Tout': 'Tout', 'Studio': 'Studio', 'Commercial': 'Commercial', 'Presse': 'Presse'} %}
                <button
                    data-portfolio-filter-target="button"
                    data-filter="{{ filter }}"
                    data-action="click->portfolio-filter#filter"
                    class="filter-btn {{ filter == 'Tout' ? 'is-active' : '' }}"
                    aria-pressed="{{ filter == 'Tout' ? 'true' : 'false' }}">
                    {{ label }}
                </button>
            {% endfor %}
        </div>
    </div>

    {# Grille #}
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
            {% for project in projects %}
                <article
                    data-portfolio-filter-target="card"
                    data-category="{{ project.category }}"
                    class="portfolio-card bg-neutral-900"
                    style="aspect-ratio: 3/4;"
                >
                    <img
                        src="{{ project.imagePath starts with 'http' ? project.imagePath : asset(project.imagePath) }}"
                        alt="{{ project.title }}"
                        class="portfolio-card__img"
                        loading="lazy"
                        width="400"
                        height="533"
                    >
                    <div class="portfolio-card__overlay">
                        <p class="text-[10px] uppercase tracking-widest mb-1.5" style="color: #C5A059;">{{ project.category }}</p>
                        <h2 class="font-serif text-lg font-light text-white">{{ project.title }}</h2>
                    </div>
                </article>
            {% else %}
                <div class="col-span-full py-24 text-center border border-dashed" style="border-color: rgba(255,255,255,0.08);">
                    <p class="text-sm italic" style="color: #6b7280;">La galerie s'enrichit régulièrement.</p>
                </div>
            {% endfor %}
        </div>
    </div>

</section>

{# CTA #}
<section class="py-20 border-t" style="background-color: #080808; border-color: rgba(255,255,255,0.06);">
    <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-8">
        <p class="font-serif text-2xl font-light text-white">
            Votre vision mérite des images à sa hauteur.
        </p>
        <a href="{{ path('devis') }}" class="btn-primary flex-shrink-0">
            Démarrer un projet
        </a>
    </div>
</section>

{% endblock %}
