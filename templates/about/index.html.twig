{% extends 'base.html.twig' %}

{% block title %}À propos — Adrien Mihajlovic{% endblock %}

{% block body %}

{# Hero #}
<section class="pt-40 pb-20 border-b" style="background-color: #0a0a0a; border-color: rgba(255,255,255,0.06);">
    <div class="max-w-7xl mx-auto px-6">
        <span class="section-label">À propos</span>
        <h1 class="font-serif font-light text-white" style="font-size: clamp(2.5rem, 6vw, 5rem); line-height: 1.05;">
            Mon<br><em style="color: #C5A059;">Parcours</em>
        </h1>
    </div>
</section>

{# Biographie — split #}
<section class="py-24" style="background-color: #0a0a0a;">
    <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-5 gap-16 items-start">

        {# Texte #}
        <div class="lg:col-span-3">
            <div class="space-y-6 text-sm leading-loose" style="color: #9ca3af;">
                {% if settings.aboutBioIntro %}
                <p class="text-base leading-loose" style="color: #c0bdb8;">{{ settings.aboutBioIntro }}</p>
                {% endif %}
                {% if settings.aboutBio1 %}
                <p>{{ settings.aboutBio1 }}</p>
                {% endif %}
                {% if settings.aboutBio2 %}
                <p>{{ settings.aboutBio2 }}</p>
                {% endif %}

                {# Citation #}
                {% if settings.aboutQuote %}
                <blockquote class="mt-10 pl-6 border-l-2 py-2" style="border-color: #C5A059;">
                    <p class="font-serif text-lg italic text-white leading-snug">
                        "{{ settings.aboutQuote }}"
                    </p>
                </blockquote>
                {% endif %}
            </div>
        </div>

        {# Portrait #}
        <div class="lg:col-span-2">
            <div class="sticky top-28">
                <div class="overflow-hidden border" style="aspect-ratio: 3/4; border-color: rgba(255,255,255,0.07);">
                    {% set portrait = settings.aboutPortraitPath %}
                    <img src="{{ portrait ? (portrait starts with 'http' ? portrait : asset(portrait)) : 'https://picsum.photos/seed/adrien-portrait/500/700' }}"
                         alt="Adrien Mihajlovic, photographe professionnel"
                         class="w-full h-full object-cover"
                         style="filter: grayscale(20%);"
                         loading="lazy"
                         width="500"
                         height="700">
                </div>
                <p class="text-xs uppercase tracking-widest mt-4 text-center" style="color: #6b7280;">
                    Adrien Mihajlovic · Photographe
                </p>
            </div>
        </div>

    </div>
</section>

{# Compétences #}
<section class="py-24 border-t" style="background-color: #080808; border-color: rgba(255,255,255,0.06);">
    <div class="max-w-7xl mx-auto px-6">
        <span class="section-label">Expertise</span>
        <h2 class="font-serif font-light text-white mb-16" style="font-size: 2rem;">Compétences &amp; Expérience</h2>

        <div class="grid sm:grid-cols-3 gap-px" style="background-color: rgba(255,255,255,0.06);">

            {% for skill in skills %}
            <div class="service-card reveal reveal-delay-{{ loop.index }}">
                <div class="w-8 h-px mb-8" style="background-color: #C5A059;"></div>
                <h3 class="font-serif text-lg text-white mb-4">{{ skill.title }}</h3>
                <p class="text-sm leading-relaxed" style="color: #9ca3af;">{{ skill.description }}</p>
            </div>
            {% else %}
            <div class="col-span-3 py-10 text-center text-gray-600 italic text-sm">Aucune compétence renseignée.</div>
            {% endfor %}

        </div>
    </div>
</section>

{# Approche #}
<section class="py-24 border-t" style="background-color: #0a0a0a; border-color: rgba(255,255,255,0.06);">
    <div class="max-w-4xl mx-auto px-6">
        <span class="section-label">Méthode de travail</span>
        <h2 class="font-serif font-light text-white mb-16" style="font-size: 2rem;">Mon Approche</h2>

        <ol class="space-y-10 list-none">
            {% for step in steps %}
            <li class="grid md:grid-cols-12 gap-6 reveal {{ not loop.last ? 'pb-10 border-b' : '' }}"
                style="{{ not loop.last ? 'border-color: rgba(255,255,255,0.06);' : '' }}">
                <div class="md:col-span-1 font-serif text-2xl font-light" style="color: rgba(255,255,255,0.15);" aria-hidden="true">0{{ loop.index }}</div>
                <div class="md:col-span-11">
                    <h3 class="font-serif text-xl text-white mb-3">{{ step.title }}</h3>
                    <p class="text-sm leading-relaxed" style="color: #9ca3af;">{{ step.description }}</p>
                </div>
            </li>
            {% else %}
            <li class="text-center py-10 text-gray-600 italic text-sm">Aucune étape renseignée.</li>
            {% endfor %}
        </ol>
    </div>
</section>

{# CTA #}
<section class="py-20 border-t" style="background-color: #080808; border-color: rgba(255,255,255,0.06);">
    <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-8">
        <div>
            <p class="font-serif text-2xl font-light text-white">Vous avez un projet en tête ?</p>
            <p class="text-sm mt-2" style="color: #6b7280;">Devis gratuit · Réponse sous 24h</p>
        </div>
        <div class="flex gap-3">
            <a href="{{ path('devis') }}" class="btn-primary">Simuler un devis</a>
            <a href="{{ path('contact') }}" class="btn-secondary">Me contacter</a>
        </div>
    </div>
</section>

{% endblock %}
