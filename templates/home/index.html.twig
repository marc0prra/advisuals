{% extends 'base.html.twig' %}

{% block title %}Adrien Mihajlovic — Photographe professionnel{% endblock %}

{% block body %}

{# ════════════════════════════════════════════════
   HERO — Full-width, animated background, no image
═══════════════════════════════════════════════ #}
<section class="relative min-h-screen flex items-center overflow-hidden" style="background-color: #0a0a0a;">

    {# Magic UI — Dot pattern #}
    <div class="magic-dot-pattern absolute inset-0 opacity-[0.035]" aria-hidden="true"></div>

    {# Magic UI — Gradient orbs #}
    <div class="magic-orb magic-orb--gold-1 absolute" style="top: 15%; left: 5%;" aria-hidden="true"></div>
    <div class="magic-orb magic-orb--gold-2 absolute" style="bottom: 10%; right: 10%;" aria-hidden="true"></div>

    {# Magic UI — Meteors #}
    <div class="meteors-container hidden lg:block" aria-hidden="true">
        <div class="meteor" style="left: 12%; --meteor-duration: 4s;  --meteor-delay: 0s;"></div>
        <div class="meteor" style="left: 28%; --meteor-duration: 5s;  --meteor-delay: 1.2s;"></div>
        <div class="meteor" style="left: 54%; --meteor-duration: 3.5s; --meteor-delay: 2s;"></div>
        <div class="meteor" style="left: 72%; --meteor-duration: 6s;  --meteor-delay: 0.5s;"></div>
        <div class="meteor" style="left: 88%; --meteor-duration: 4.5s; --meteor-delay: 3s;"></div>
    </div>

    {# Bottom gradient fade #}
    <div class="absolute bottom-0 left-0 right-0 h-32 pointer-events-none" aria-hidden="true"
         style="background: linear-gradient(to bottom, transparent, #0a0a0a);"></div>

    {# Content #}
    <div class="relative z-10 w-full max-w-7xl mx-auto px-6 pt-40 pb-20 lg:pt-52 lg:pb-32">

        <div class="max-w-4xl">
            <span class="section-label reveal">Photographe professionnel · Paris</span>

            <h1 class="font-serif font-light text-white leading-[1.05] mb-8 reveal reveal-delay-1"
                style="font-size: clamp(3.2rem, 7vw, 6.5rem);">
                Des images<br>
                <em class="shimmer-text">qui font sens.</em>
            </h1>

            <p class="text-base leading-relaxed mb-10 max-w-lg reveal reveal-delay-2" style="color: #9ca3af;">
                Portrait, commercial, presse — je documente ce qui compte<br class="hidden md:inline">
                avec précision et authenticité.
            </p>

            <div class="flex flex-col sm:flex-row gap-3 mb-20 reveal reveal-delay-3">
                <a href="{{ path('portfolio') }}" class="btn-primary border-beam">
                    Voir le portfolio
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                    </svg>
                </a>
                <a href="{{ path('devis') }}" class="btn-secondary">
                    Obtenir un devis
                </a>
            </div>

            {# Stats avec number ticker #}
            <div class="grid grid-cols-3 gap-8 pt-8 border-t reveal reveal-delay-4"
                 style="border-color: rgba(255,255,255,0.07); max-width: 400px;">
                <div>
                    <p class="font-serif text-3xl font-light mb-1 text-white">
                        <span class="number-ticker" data-target="5">5</span>+
                    </p>
                    <p class="text-xs uppercase tracking-widest" style="color: #6b7280;">Années</p>
                </div>
                <div>
                    <p class="font-serif text-3xl font-light mb-1 text-white">
                        <span class="number-ticker" data-target="200">200</span>+
                    </p>
                    <p class="text-xs uppercase tracking-widest" style="color: #6b7280;">Projets</p>
                </div>
                <div>
                    <p class="font-serif text-3xl font-light mb-1 text-white">
                        <span class="number-ticker" data-target="50">50</span>+
                    </p>
                    <p class="text-xs uppercase tracking-widest" style="color: #6b7280;">Clients</p>
                </div>
            </div>
        </div>

        {# Scroll indicator #}
        <a href="#selected-works" class="scroll-indicator mt-16 hidden lg:flex reveal reveal-delay-5" aria-label="Voir les travaux">
            <span class="scroll-indicator__line"></span>
            <span>Défiler</span>
        </a>

    </div>
</section>

{# ════════════════════════════════════════════════
   PORTFOLIO RÉCENT — grille uniforme propre
═══════════════════════════════════════════════ #}
<section id="selected-works" class="py-28" style="background-color: #0a0a0a;">
    <div class="max-w-7xl mx-auto px-6">

        <div class="flex items-end justify-between mb-14 reveal">
            <div>
                <span class="section-label">Travaux sélectionnés</span>
                <h2 class="font-serif font-light text-white" style="font-size: clamp(1.8rem, 3.5vw, 2.8rem);">
                    Portfolio récent
                </h2>
            </div>
            <a href="{{ path('portfolio') }}"
               class="hidden md:inline-flex items-center gap-2 text-xs uppercase tracking-widest transition-colors hover:text-white"
               style="color: #6b7280; letter-spacing: 0.2em;">
                Tout voir
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
            </a>
        </div>

        {# Grille uniforme — 3 colonnes, aspect ratio identique, gap propre #}
        {% set fp = projects %}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">

            {% for i in 0..5 %}
                {% if fp[i] is defined %}
                <div class="reveal reveal-delay-{{ (loop.index % 3) + 1 }}">
                    <article class="portfolio-card" style="aspect-ratio: 4/5;">
                        <img
                            src="{{ fp[i].imagePath starts with 'http' ? fp[i].imagePath : asset(fp[i].imagePath) }}"
                            alt="{{ fp[i].title }}"
                            class="portfolio-card__img"
                            loading="{{ i == 0 ? 'eager' : 'lazy' }}"
                            width="480"
                            height="600"
                        >
                        <div class="portfolio-card__overlay">
                            <p class="text-[10px] uppercase tracking-widest mb-1.5" style="color: #C5A059;">{{ fp[i].category }}</p>
                            <h3 class="font-serif text-base font-light text-white">{{ fp[i].title }}</h3>
                        </div>
                    </article>
                </div>
                {% endif %}
            {% endfor %}

            {% if projects is empty %}
            <div class="col-span-full py-24 text-center border border-dashed reveal"
                 style="border-color: rgba(255,255,255,0.08);">
                <p class="text-sm italic" style="color: #6b7280;">La galerie s'enrichit régulièrement.</p>
            </div>
            {% endif %}

        </div>

        <div class="text-center mt-10 md:hidden reveal">
            <a href="{{ path('portfolio') }}" class="btn-secondary">
                Voir tout le portfolio
            </a>
        </div>

    </div>
</section>

{# ════════════════════════════════════════════════
   SERVICES — 3 colonnes
═══════════════════════════════════════════════ #}
<section class="py-28 border-t" style="background-color: #0a0a0a; border-color: rgba(255,255,255,0.06);">
    <div class="max-w-7xl mx-auto px-6">

        <div class="flex items-end justify-between mb-12 reveal">
            <div>
                <span class="section-label">Ce que je propose</span>
                <h2 class="font-serif font-light text-white" style="font-size: clamp(1.8rem, 3.5vw, 2.8rem);">
                    Services
                </h2>
            </div>
            <a href="{{ path('services') }}"
               class="hidden md:inline-flex items-center gap-2 text-xs uppercase tracking-widest transition-colors hover:text-white"
               style="color: #6b7280; letter-spacing: 0.2em;">
                Toute l'offre
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
            </a>
        </div>

        <div class="grid md:grid-cols-3 divide-y md:divide-y-0 md:divide-x"
             style="border: 1px solid rgba(255,255,255,0.07);">

            <div class="service-card reveal reveal-delay-1">
                <p class="font-serif text-4xl font-light mb-6" style="color: rgba(255,255,255,0.08);">01</p>
                <h3 class="font-serif text-xl text-white mb-2">Portrait &amp; Studio</h3>
                <p class="text-2xl font-light mb-6" style="color: #C5A059;">250 €
                    <span class="text-sm" style="color: #6b7280;">/ séance</span>
                </p>
                <p class="text-sm leading-relaxed mb-8" style="color: #9ca3af;">
                    Séances studio haute définition. Lumière maîtrisée, retouche incluse.
                </p>
                <ul class="space-y-2 text-xs mb-10" style="color: #6b7280;">
                    <li>— Séance 2h en studio</li>
                    <li>— 10 photos retouchées</li>
                    <li>— Livraison HD sous 7 jours</li>
                </ul>
                <a href="{{ path('devis') }}" class="cta-link">Demander un devis →</a>
            </div>

            <div class="service-card relative reveal reveal-delay-2">
                <div class="absolute top-0 left-0 right-0 h-px" style="background-color: #C5A059;"></div>
                <p class="font-serif text-4xl font-light mb-6" style="color: rgba(255,255,255,0.08);">02</p>
                <h3 class="font-serif text-xl text-white mb-2">Shooting Commercial</h3>
                <p class="text-2xl font-light mb-6" style="color: #C5A059;">500 €
                    <span class="text-sm" style="color: #6b7280;">/ jour</span>
                </p>
                <p class="text-sm leading-relaxed mb-8" style="color: #9ca3af;">
                    Campagnes, lookbooks, catalogues. Direction artistique adaptée.
                </p>
                <ul class="space-y-2 text-xs mb-10" style="color: #6b7280;">
                    <li>— Journée complète (8h)</li>
                    <li>— 30+ photos livrées</li>
                    <li>— Direction artistique incluse</li>
                    <li>— Droits commerciaux</li>
                </ul>
                <a href="{{ path('devis') }}" class="cta-link">Demander un devis →</a>
            </div>

            <div class="service-card reveal reveal-delay-3">
                <p class="font-serif text-4xl font-light mb-6" style="color: rgba(255,255,255,0.08);">03</p>
                <h3 class="font-serif text-xl text-white mb-2">Reportage &amp; Presse</h3>
                <p class="text-2xl font-light mb-6" style="color: #C5A059;">400 €
                    <span class="text-sm" style="color: #6b7280;">/ jour</span>
                </p>
                <p class="text-sm leading-relaxed mb-8" style="color: #9ca3af;">
                    Fashion weeks, événements, backstages. Réactivité et discrétion.
                </p>
                <ul class="space-y-2 text-xs mb-10" style="color: #6b7280;">
                    <li>— Accréditation presse gérée</li>
                    <li>— Livraison sous 24h</li>
                    <li>— Droits éditoriaux inclus</li>
                </ul>
                <a href="{{ path('devis') }}" class="cta-link">Demander un devis →</a>
            </div>

        </div>

    </div>
</section>

{# ════════════════════════════════════════════════
   À PROPOS — teaser (contenu éditable depuis backoffice)
═══════════════════════════════════════════════ #}
<section class="py-28 border-t" style="background-color: #080808; border-color: rgba(255,255,255,0.06);">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid lg:grid-cols-2 gap-16 items-center">

            <div class="reveal">
                <span class="section-label">À propos</span>
                <h2 class="font-serif font-light text-white mb-6" style="font-size: clamp(1.8rem, 3.5vw, 2.8rem);">
                    {{ settings.homeAboutTitle ?: 'Autodidacte passionné,<br><em>exigeant par nature.</em>'|raw }}
                </h2>
                {% if settings.homeAboutText1 %}
                <p class="text-sm leading-relaxed mb-4" style="color: #9ca3af;">{{ settings.homeAboutText1 }}</p>
                {% else %}
                <p class="text-sm leading-relaxed mb-4" style="color: #9ca3af;">Mon parcours atypique m'a conduit de la formation autodidacte jusqu'à des collaborations avec Adidas, Lacoste, Vogue Paris.</p>
                {% endif %}
                {% if settings.homeAboutText2 %}
                <p class="text-sm leading-relaxed mb-10" style="color: #9ca3af;">{{ settings.homeAboutText2 }}</p>
                {% else %}
                <p class="text-sm leading-relaxed mb-10" style="color: #9ca3af;">Portrait, reportage, commercial — ma polyvalence est ma force. Mon exigence, ma marque de fabrique.</p>
                {% endif %}
                <a href="{{ path('about') }}"
                   class="inline-flex items-center gap-2 text-xs uppercase tracking-widest transition-colors hover:text-white"
                   style="color: #C5A059; letter-spacing: 0.2em;">
                    En savoir plus
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                    </svg>
                </a>
            </div>

            <div class="relative reveal reveal-delay-2">
                {% set aboutImg = settings.homeAboutImagePath %}
                <img src="{{ aboutImg ? (aboutImg starts with 'http' ? aboutImg : asset(aboutImg)) : 'https://picsum.photos/seed/adrien-portrait/560/700' }}"
                     alt="Adrien Mihajlovic, photographe"
                     class="w-full object-cover"
                     style="aspect-ratio: 4/5; filter: grayscale(25%);"
                     loading="lazy"
                     width="560"
                     height="700">
                {% if settings.homeAboutQuote %}
                <div class="absolute bottom-6 left-6 right-6 p-5 border"
                     style="background-color: rgba(10,10,10,0.9); border-color: rgba(255,255,255,0.08); backdrop-filter: blur(8px);">
                    <p class="font-serif text-sm italic text-white leading-relaxed">
                        "{{ settings.homeAboutQuote }}"
                    </p>
                </div>
                {% endif %}
            </div>

        </div>
    </div>
</section>

{# ════════════════════════════════════════════════
   TÉMOIGNAGES
═══════════════════════════════════════════════ #}
<section class="py-28 border-t" style="background-color: #0a0a0a; border-color: rgba(255,255,255,0.06);">
    <div class="max-w-7xl mx-auto px-6">

        <div class="mb-12 reveal">
            <span class="section-label">Ce qu'ils disent</span>
            <h2 class="font-serif font-light text-white" style="font-size: clamp(1.8rem, 3.5vw, 2.8rem);">
                Témoignages
            </h2>
        </div>

        <div class="grid md:grid-cols-3 gap-px" style="background-color: rgba(255,255,255,0.06);">

            {% for t in testimonials %}
            <article class="testimonial-card reveal reveal-delay-{{ loop.index }}" {{ loop.index == 2 ? 'style="background-color: #0f0f0f;"' : '' }}>
                <div class="mb-6" style="color: #C5A059; font-size: 0.7rem; letter-spacing: 0.15em;"
                     aria-label="{{ t.rating }} étoiles sur 5">
                    <span aria-hidden="true">{% for s in 1..5 %}{{ s <= t.rating ? '★' : '☆' }}{% endfor %}</span>
                </div>
                <blockquote class="text-sm leading-relaxed mb-8 italic" style="color: #9ca3af;">
                    "{{ t.quote }}"
                </blockquote>
                <footer class="pt-6 border-t" style="border-color: rgba(255,255,255,0.06);">
                    <p class="text-sm font-medium text-white">{{ t.author }}</p>
                    <p class="text-xs mt-0.5" style="color: #6b7280;">{{ t.role }}</p>
                </footer>
            </article>
            {% else %}
            <div class="col-span-3 py-12 text-center text-gray-600 italic text-sm">
                Aucun témoignage configuré pour le moment.
            </div>
            {% endfor %}

        </div>

    </div>
</section>

{# ════════════════════════════════════════════════
   CTA FINAL
═══════════════════════════════════════════════ #}
<section class="relative py-28 border-t overflow-hidden" style="background-color: #080808; border-color: rgba(255,255,255,0.06);">
    {# Subtle orb behind CTA #}
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none" aria-hidden="true">
        <div style="width: 600px; height: 300px; background: radial-gradient(ellipse, rgba(197,160,89,0.06) 0%, transparent 70%); filter: blur(40px);"></div>
    </div>
    <div class="relative z-10 max-w-3xl mx-auto px-6 text-center">
        <span class="section-label reveal" style="display: inline-block;">Travaillons ensemble</span>
        <h2 class="font-serif font-light text-white mb-6 reveal reveal-delay-1" style="font-size: clamp(2rem, 4.5vw, 3.5rem);">
            Votre projet mérite<br>
            <em class="shimmer-text">des images à sa hauteur.</em>
        </h2>
        <p class="text-sm leading-relaxed mb-10 reveal reveal-delay-2" style="color: #9ca3af;">
            Discutons de votre vision. Devis gratuit, réponse sous 24h.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center reveal reveal-delay-3">
            <a href="{{ path('devis') }}" class="btn-primary border-beam">
                Simuler mon devis
            </a>
            <a href="{{ path('contact') }}" class="btn-secondary">
                Me contacter
            </a>
        </div>
    </div>
</section>

{% endblock %}
