{% extends 'admin/base.html.twig' %}
{% block title %}Dashboard — Backoffice{% endblock %}
{% block page_title %}Dashboard{% endblock %}

{% block content %}

{# KPI grid #}
<div style="display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:24px;">

    <div class="admin-card a-reveal" style="position:relative; overflow:hidden;">
        <p style="font-size:11px;text-transform:uppercase;letter-spacing:.1em;color:hsl(0 0% 40%);margin-bottom:8px;">Devis en attente</p>
        <p style="font-size:32px;font-weight:700;color:#C5A059;line-height:1;margin-bottom:10px;">{{ pending_count }}</p>
        <a href="{{ path('app_admin_devis') }}" data-turbo="false"
           style="font-size:12px;color:hsl(0 0% 45%);text-decoration:none;transition:color .15s;"
           onmouseover="this.style.color='#C5A059'" onmouseout="this.style.color='hsl(0 0% 45%)'">Voir les devis →</a>
        <div style="position:absolute;bottom:-20px;right:-16px;width:80px;height:80px;border-radius:50%;background:rgba(197,160,89,.06);"></div>
    </div>

    <div class="admin-card a-reveal a-reveal-d1" style="position:relative; overflow:hidden;">
        <p style="font-size:11px;text-transform:uppercase;letter-spacing:.1em;color:hsl(0 0% 40%);margin-bottom:8px;">CA du mois</p>
        <p style="font-size:32px;font-weight:700;color:#fff;line-height:1;margin-bottom:10px;">{{ month_stats.total|number_format(0, ',', ' ') }} €</p>
        <a href="{{ path('app_admin_revenue') }}" data-turbo="false"
           style="font-size:12px;color:hsl(0 0% 45%);text-decoration:none;transition:color .15s;"
           onmouseover="this.style.color='#C5A059'" onmouseout="this.style.color='hsl(0 0% 45%)'">Voir le CA →</a>
        <div style="position:absolute;bottom:-20px;right:-16px;width:80px;height:80px;border-radius:50%;background:rgba(255,255,255,.03);"></div>
    </div>

    <div class="admin-card a-reveal a-reveal-d2" style="position:relative; overflow:hidden;">
        <p style="font-size:11px;text-transform:uppercase;letter-spacing:.1em;color:hsl(0 0% 40%);margin-bottom:8px;">Part Adrien (70%)</p>
        <p style="font-size:32px;font-weight:700;color:hsl(142 55% 55%);line-height:1;margin-bottom:10px;">{{ month_stats.adrien|number_format(0, ',', ' ') }} €</p>
        <span style="font-size:12px;color:hsl(0 0% 40%);">— ce mois</span>
        <div style="position:absolute;bottom:-20px;right:-16px;width:80px;height:80px;border-radius:50%;background:rgba(74,222,128,.04);"></div>
    </div>

    <div class="admin-card a-reveal a-reveal-d3" style="position:relative; overflow:hidden;">
        <p style="font-size:11px;text-transform:uppercase;letter-spacing:.1em;color:hsl(0 0% 40%);margin-bottom:8px;">Part Marco (30%)</p>
        <p style="font-size:32px;font-weight:700;color:hsl(213 85% 65%);line-height:1;margin-bottom:10px;">{{ month_stats.marco|number_format(0, ',', ' ') }} €</p>
        <span style="font-size:12px;color:hsl(0 0% 40%);">— ce mois</span>
        <div style="position:absolute;bottom:-20px;right:-16px;width:80px;height:80px;border-radius:50%;background:rgba(96,165,250,.04);"></div>
    </div>
</div>

{# Recent requests #}
<div class="admin-card a-reveal a-reveal-d4">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;">
        <div style="display:flex;align-items:center;gap:10px;">
            <div style="width:3px;height:18px;background:#C5A059;border-radius:2px;"></div>
            <h2 style="font-size:14px;font-weight:600;color:#fff;">Dernières demandes</h2>
        </div>
        <a href="{{ path('app_admin_devis') }}" data-turbo="false"
           style="font-size:12px;color:#C5A059;text-decoration:none;">Voir tout →</a>
    </div>

    {% if recent_requests is empty %}
    <div style="text-align:center;padding:40px;font-size:13px;color:hsl(0 0% 35%);font-style:italic;">
        Aucune demande pour l'instant.
    </div>
    {% else %}
    <div style="overflow-x:auto;">
        <table style="width:100%;border-collapse:collapse;font-size:13px;">
            <thead>
                <tr style="border-bottom:1px solid hsl(0 0% 10%);">
                    <th style="padding:9px 12px;text-align:left;font-size:10.5px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:hsl(0 0% 38%);">Client</th>
                    <th style="padding:9px 12px;text-align:left;font-size:10.5px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:hsl(0 0% 38%);">Email</th>
                    <th style="padding:9px 12px;text-align:left;font-size:10.5px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:hsl(0 0% 38%);">Montant</th>
                    <th style="padding:9px 12px;text-align:left;font-size:10.5px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:hsl(0 0% 38%);">Date</th>
                    <th style="padding:9px 12px;text-align:left;font-size:10.5px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:hsl(0 0% 38%);">Statut</th>
                </tr>
            </thead>
            <tbody>
                {% for req in recent_requests %}
                <tr style="border-bottom:1px solid hsl(0 0% 7%);transition:background .1s;"
                    onmouseover="this.style.background='hsl(0 0% 6%)'"
                    onmouseout="this.style.background=''">
                    <td style="padding:12px;color:#e5e5e5;font-weight:500;">{{ req.clientName }}</td>
                    <td style="padding:12px;color:hsl(0 0% 50%);">{{ req.clientEmail }}</td>
                    <td style="padding:12px;font-weight:600;color:#C5A059;">{{ req.totalEstimated|number_format(0, ',', ' ') }} €</td>
                    <td style="padding:12px;color:hsl(0 0% 45%);">{{ req.createdAt|date('d/m/Y') }}</td>
                    <td style="padding:12px;">
                        {% if req.status == 'en_attente' %}
                        <span style="padding:3px 9px;border-radius:5px;font-size:11px;font-weight:600;background:hsl(48 60% 10%);color:hsl(48 80% 65%);border:1px solid hsl(48 60% 18%);">En attente</span>
                        {% elseif req.status == 'accepte' %}
                        <span style="padding:3px 9px;border-radius:5px;font-size:11px;font-weight:600;background:hsl(142 40% 8%);color:hsl(142 55% 58%);border:1px solid hsl(142 40% 16%);">Accepté</span>
                        {% else %}
                        <span style="padding:3px 9px;border-radius:5px;font-size:11px;font-weight:600;background:hsl(0 40% 8%);color:hsl(0 55% 58%);border:1px solid hsl(0 40% 16%);">Refusé</span>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</div>

<style>
@media (max-width: 900px) {
    [style*="grid-template-columns:repeat(4,1fr)"] { grid-template-columns: repeat(2,1fr) !important; }
}
@media (max-width: 500px) {
    [style*="grid-template-columns:repeat(4,1fr)"], [style*="grid-template-columns: repeat(4,1fr)"] { grid-template-columns: 1fr !important; }
}
</style>
{% endblock %}
