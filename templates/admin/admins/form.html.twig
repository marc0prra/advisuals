{% extends 'admin/base.html.twig' %}
{% block title %}{{ admin ? 'Modifier' : 'Nouvel' }} admin — Backoffice{% endblock %}
{% block page_title %}{{ admin ? 'Modifier un administrateur' : 'Nouvel administrateur' }}{% endblock %}

{% block content %}
<div class="a-reveal">

    <a href="{{ path('app_admin_admins') }}" data-turbo="false" class="btn-ghost" style="margin-bottom:28px;display:inline-flex;gap:6px;align-items:center;">
        <svg style="width:14px;height:14px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        Retour aux admins
    </a>

    <form method="post" action="{{ action }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_form') }}">

        <div class="admin-card" style="display:flex;flex-direction:column;gap:18px;">

            <div>
                <label class="admin-label" for="email">Email <span>*</span></label>
                <input class="admin-input" type="email" id="email" name="email" required
                       value="{{ admin ? admin.email : '' }}"
                       placeholder="admin@exemple.com">
            </div>

            <div>
                <label class="admin-label" for="password">
                    Mot de passe
                    {% if not admin %}<span>*</span>{% else %}<span style="color:hsl(0 0% 35%);font-weight:400;">(laisser vide pour conserver)</span>{% endif %}
                </label>
                <input class="admin-input" type="password" id="password" name="password"
                       {% if not admin %}required{% endif %}
                       placeholder="••••••••">
            </div>

            <div>
                <label class="admin-label" for="role">Rôle</label>
                <select class="admin-select" id="role" name="role">
                    <option value="ROLE_ADMIN" {% if not admin or 'ROLE_ADMIN' in admin.roles %}selected{% endif %}>ROLE_ADMIN</option>
                </select>
            </div>

            <div style="display:flex;gap:10px;padding-top:4px;">
                <button type="submit" class="btn-gold">{{ admin ? 'Enregistrer' : 'Créer le compte' }}</button>
                <a href="{{ path('app_admin_admins') }}" data-turbo="false" class="btn-ghost">Annuler</a>
            </div>

        </div>
    </form>
</div>
{% endblock %}
