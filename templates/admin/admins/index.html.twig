{% extends 'admin/base.html.twig' %}
{% block title %}Admins — Backoffice{% endblock %}
{% block page_title %}Administrateurs{% endblock %}

{% block content %}

<div class="admin-card a-reveal">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
        <div style="display:flex;align-items:center;gap:10px;">
            <div style="width:3px;height:18px;background:#C5A059;border-radius:2px;"></div>
            <h2 style="font-size:14px;font-weight:600;color:#fff;">Comptes administrateurs</h2>
        </div>
        <a href="{{ path('app_admin_admins_new') }}" data-turbo="false" class="btn-gold" style="font-size:11px;padding:7px 14px;">
            + Ajouter
        </a>
    </div>

    <div style="overflow-x:auto;">
        <table style="width:100%;border-collapse:collapse;font-size:13px;">
            <thead>
                <tr style="border-bottom:1px solid hsl(0 0% 10%);">
                    {% for h in ['#','Email','Rôle','Actions'] %}
                    <th style="padding:9px 12px;text-align:left;font-size:10.5px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:hsl(0 0% 38%);white-space:nowrap;">{{ h }}</th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                {% for admin in admins %}
                <tr style="border-bottom:1px solid hsl(0 0% 7%);transition:background .1s;"
                    onmouseover="this.style.background='hsl(0 0% 6%)'"
                    onmouseout="this.style.background=''">
                    <td style="padding:12px;color:hsl(0 0% 35%);">{{ admin.id }}</td>
                    <td style="padding:12px;">
                        <div style="display:flex;align-items:center;gap:8px;">
                            <span style="color:#e5e5e5;font-weight:500;">{{ admin.email }}</span>
                            {% if admin.getUserIdentifier() == app.user.getUserIdentifier() %}
                            <span style="padding:2px 7px;border-radius:4px;font-size:10px;font-weight:600;background:hsl(0 0% 10%);color:hsl(0 0% 45%);border:1px solid hsl(0 0% 14%);">Vous</span>
                            {% endif %}
                        </div>
                    </td>
                    <td style="padding:12px;">
                        {% for role in admin.roles %}
                        <span style="padding:2px 8px;border-radius:4px;font-size:10.5px;font-weight:600;background:hsl(48 40% 8%);color:hsl(48 70% 55%);border:1px solid hsl(48 40% 14%);margin-right:4px;">{{ role }}</span>
                        {% endfor %}
                    </td>
                    <td style="padding:12px;">
                        <div style="display:flex;gap:8px;align-items:center;">
                            <a href="{{ path('app_admin_admins_edit', {id: admin.id}) }}" data-turbo="false" class="btn-ghost" style="font-size:11px;padding:5px 11px;">
                                Modifier
                            </a>
                            {% if admin.getUserIdentifier() != app.user.getUserIdentifier() %}
                            <button type="button" class="btn-danger" style="font-size:11px;padding:5px 11px;"
                                    onclick="openDeleteModal({
                                        action: '{{ path('app_admin_admins_delete', {id: admin.id}) }}',
                                        token: '{{ csrf_token('admin_delete') }}',
                                        description: 'Supprimer l\\'administrateur <strong>{{ admin.email }}</strong> ? Cette action est irréversible.'
                                    })">
                                Supprimer
                            </button>
                            {% endif %}
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% endblock %}
