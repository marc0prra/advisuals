{% extends 'admin/base.html.twig' %}

{% block title %}Admins — Backoffice AD Visuals{% endblock %}
{% block page_title %}Gestion des administrateurs{% endblock %}

{% block content %}

<div class="flex justify-end mb-6">
    <a href="{{ path('app_admin_admins_new') }}"
       class="px-4 py-2 text-xs font-semibold uppercase tracking-widest rounded transition-colors"
       style="background-color: #C5A059; color: #0a0a0a;">
        + Ajouter un admin
    </a>
</div>

<div class="rounded-xl border border-gray-800 overflow-hidden" style="background-color: #0d0d0d;">
    <table class="w-full text-sm">
        <thead>
            <tr class="text-left text-xs uppercase tracking-widest text-gray-500 border-b border-gray-800">
                <th class="px-6 py-3">#</th>
                <th class="px-6 py-3">Email</th>
                <th class="px-6 py-3">Rôle</th>
                <th class="px-6 py-3">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-800">
            {% for admin in admins %}
                <tr class="hover:bg-white/5 transition-colors">
                    <td class="px-6 py-4 text-gray-500">{{ admin.id }}</td>
                    <td class="px-6 py-4">
                        <span class="text-white font-medium">{{ admin.email }}</span>
                        {% if admin.getUserIdentifier() == app.user.getUserIdentifier() %}
                            <span class="ml-2 px-2 py-0.5 rounded-full text-xs bg-gray-700 text-gray-400">Vous</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4">
                        {% for role in admin.roles %}
                            <span class="px-2 py-0.5 rounded text-xs bg-gray-800 text-gray-300 border border-gray-700">{{ role }}</span>
                        {% endfor %}
                    </td>
                    <td class="px-6 py-4">
                        <div class="flex gap-2">
                            <a href="{{ path('app_admin_admins_edit', {id: admin.id}) }}"
                               class="px-3 py-1.5 text-xs rounded border border-gray-600 text-gray-400 hover:text-white hover:border-gray-400 transition-colors">
                                Modifier
                            </a>
                            {% if admin.getUserIdentifier() != app.user.getUserIdentifier() %}
                                <form method="post" action="{{ path('app_admin_admins_delete', {id: admin.id}) }}"
                                      onsubmit="return confirm('Supprimer cet administrateur ?')">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_delete') }}">
                                    <button type="submit"
                                            class="px-3 py-1.5 text-xs rounded border border-red-800 text-red-400 hover:bg-red-900/30 transition-colors">
                                        Supprimer
                                    </button>
                                </form>
                            {% endif %}
                        </div>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{% endblock %}
