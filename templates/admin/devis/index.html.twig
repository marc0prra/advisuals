{% extends 'admin/base.html.twig' %}

{% block title %}Devis — Backoffice AD Visuals{% endblock %}
{% block page_title %}Gestion des devis{% endblock %}

{% block content %}

<div class="rounded-xl border border-gray-800 overflow-hidden" style="background-color: #0d0d0d;">
    <div class="px-6 py-4 border-b border-gray-800 flex items-center justify-between">
        <h2 class="text-sm font-semibold text-white">Toutes les demandes</h2>
        <span class="text-xs text-gray-500">{{ requests | length }} demande(s)</span>
    </div>

    {% if requests is empty %}
        <div class="px-6 py-10 text-center text-gray-500 text-sm italic">Aucune demande de devis reçue.</div>
    {% else %}
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="text-left text-xs uppercase tracking-widest text-gray-500 border-b border-gray-800">
                        <th class="px-6 py-3">Date</th>
                        <th class="px-6 py-3">Client</th>
                        <th class="px-6 py-3">Contact</th>
                        <th class="px-6 py-3">Service</th>
                        <th class="px-6 py-3">Montant</th>
                        <th class="px-6 py-3">Statut</th>
                        <th class="px-6 py-3">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-800">
                    {% for req in requests %}
                        <tr class="hover:bg-white/5 transition-colors">
                            <td class="px-6 py-4 text-gray-400 whitespace-nowrap">{{ req.createdAt | date('d/m/Y H:i') }}</td>
                            <td class="px-6 py-4">
                                <p class="text-white font-medium">{{ req.clientName }}</p>
                                <p class="text-gray-500 text-xs">{{ req.clientPhone }}</p>
                            </td>
                            <td class="px-6 py-4 text-gray-400">
                                <a href="mailto:{{ req.clientEmail }}" class="hover:underline" style="text-decoration-color: #C5A059;">{{ req.clientEmail }}</a>
                            </td>
                            <td class="px-6 py-4 text-gray-400">
                                {{ services[req.serviceId] ?? 'N/A' }}
                            </td>
                            <td class="px-6 py-4 font-bold" style="color: #C5A059;">
                                {{ req.totalEstimated | number_format(0, ',', ' ') }} €
                            </td>
                            <td class="px-6 py-4">
                                {% if req.status == 'en_attente' %}
                                    <span class="px-2 py-1 rounded-full text-xs font-medium bg-yellow-900/50 text-yellow-300 border border-yellow-700">En attente</span>
                                {% elseif req.status == 'accepte' %}
                                    <span class="px-2 py-1 rounded-full text-xs font-medium bg-green-900/50 text-green-300 border border-green-700">Accepté</span>
                                {% else %}
                                    <span class="px-2 py-1 rounded-full text-xs font-medium bg-red-900/50 text-red-300 border border-red-700">Refusé</span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4">
                                {% if req.status == 'en_attente' %}
                                    <div class="flex gap-2">
                                        <form method="post" action="{{ path('app_admin_devis_accept', {id: req.id}) }}" onsubmit="return confirm('Accepter ce devis de {{ req.totalEstimated }}€ ?')">
                                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('devis_admin') }}">
                                            <button type="submit" class="px-3 py-1.5 text-xs font-semibold rounded transition-colors bg-green-900/50 text-green-300 border border-green-700 hover:bg-green-800/50">
                                                Accepter
                                            </button>
                                        </form>
                                        <form method="post" action="{{ path('app_admin_devis_refuse', {id: req.id}) }}" onsubmit="return confirm('Refuser ce devis ?')">
                                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('devis_admin') }}">
                                            <button type="submit" class="px-3 py-1.5 text-xs font-semibold rounded transition-colors bg-red-900/50 text-red-300 border border-red-700 hover:bg-red-800/50">
                                                Refuser
                                            </button>
                                        </form>
                                    </div>
                                {% else %}
                                    <span class="text-gray-600 text-xs italic">Traité</span>
                                {% endif %}
                            </td>
                        </tr>
                        {% if req.message %}
                            <tr class="border-b border-gray-800 bg-black/20">
                                <td colspan="7" class="px-6 py-3">
                                    <p class="text-gray-500 text-xs"><span class="text-gray-400 font-medium">Message :</span> {{ req.message }}</p>
                                </td>
                            </tr>
                        {% endif %}
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

{% endblock %}
