{% extends 'admin/base.html.twig' %}
{% block title %}Portfolio — Backoffice{% endblock %}
{% block page_title %}Portfolio{% endblock %}

{% block content %}
<div class="flex items-center justify-between mb-8 a-reveal">
    <p style="font-size:13px; color:hsl(0 0% 45%);">{{ projects|length }} projet(s)</p>
    <a href="{{ path('admin_portfolio_new') }}" class="btn-gold">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Nouveau projet
    </a>
</div>

{# Grid #}
<div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
    {% for project in projects %}
    <div class="group relative rounded-xl overflow-hidden border a-reveal a-reveal-d{{ (loop.index0 % 4) + 1 }}"
         style="border-color:hsl(0 0% 10%); background:hsl(0 0% 5.5%);">

        <div class="relative overflow-hidden" style="aspect-ratio:4/3; background:hsl(0 0% 7%);">
            {% if project.imagePath %}
            <img src="{{ asset(project.imagePath) }}" alt="{{ project.title }}"
                 class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105">
            {% else %}
            <div class="w-full h-full flex items-center justify-center" style="color:hsl(0 0% 25%);">
                <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            </div>
            {% endif %}

            {% if project.isFeatured %}
            <span class="badge-gold absolute top-2 left-2">★ Une</span>
            {% endif %}

            {# Hover overlay #}
            <div class="absolute inset-0 flex items-center justify-center gap-2
                        opacity-0 group-hover:opacity-100 transition-opacity duration-200"
                 style="background:rgba(0,0,0,.6);">
                <a href="{{ path('admin_portfolio_edit', {id: project.id}) }}"
                   class="btn-ghost" style="padding:7px 14px; font-size:12px;">
                    Modifier
                </a>
                <button type="button" class="btn-danger"
                        style="padding:7px 14px;"
                        onclick="openDeleteModal({
                            action: '{{ path('admin_portfolio_delete', {id: project.id}) }}',
                            token: '{{ csrf_token('delete_project_' ~ project.id) }}',
                            description: 'Supprimer le projet « {{ project.title|e('js') }} » ? Cette action est irréversible.'
                        })">
                    Supprimer
                </button>
            </div>
        </div>

        <div style="padding:10px 12px;">
            <p style="font-size:13px; font-weight:500; color:#e5e5e5;" class="truncate">{{ project.title }}</p>
            <p style="font-size:11px; color:hsl(0 0% 42%); margin-top:2px;">{{ project.category }}</p>
        </div>
    </div>
    {% else %}
    <div class="col-span-full a-reveal" style="text-align:center; padding:60px 0; color:hsl(0 0% 30%);">
        <svg class="w-10 h-10 mx-auto mb-3 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        <p style="font-size:13px;">Aucun projet. Créez-en un !</p>
    </div>
    {% endfor %}
</div>

{% if projects|length > 0 %}
<div class="admin-card a-reveal" style="margin-top:32px; display:flex; align-items:center; justify-content:space-between; gap:16px;">
    <div>
        <p style="font-size:14px; font-weight:600; color:#fff; margin-bottom:4px;">Grille de la page d'accueil</p>
        <p style="font-size:12px; color:hsl(0 0% 45%);">Gérez visuellement les photos mises en avant, leur ordre et taille.</p>
    </div>
    <a href="{{ path('admin_homepage') }}#featured-grid" class="btn-ghost">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
        Gérer la grille
    </a>
</div>
{% endif %}
{% endblock %}
