{% extends 'admin/base.html.twig' %}

{% block title %}Messages — Backoffice AD Visuals{% endblock %}
{% block page_title %}Messages clients{% endblock %}

{% block content %}

<div class="space-y-4">
    {% if requests is empty %}
        <div class="rounded-xl border border-gray-800 px-6 py-10 text-center text-gray-500 text-sm italic" style="background-color: #0d0d0d;">
            Aucun message reçu pour l'instant.
        </div>
    {% else %}
        {% for req in requests %}
            <div class="rounded-xl border border-gray-800 p-6" style="background-color: #0d0d0d;">
                <div class="flex items-start justify-between gap-4 flex-wrap">
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-3 flex-wrap mb-1">
                            <span class="font-semibold text-white">{{ req.clientName }}</span>
                            {% if req.status == 'en_attente' %}
                                <span class="px-2 py-0.5 rounded-full text-xs bg-yellow-900/50 text-yellow-300 border border-yellow-700">En attente</span>
                            {% elseif req.status == 'accepte' %}
                                <span class="px-2 py-0.5 rounded-full text-xs bg-green-900/50 text-green-300 border border-green-700">Accepté</span>
                            {% else %}
                                <span class="px-2 py-0.5 rounded-full text-xs bg-red-900/50 text-red-300 border border-red-700">Refusé</span>
                            {% endif %}
                        </div>
                        <div class="flex gap-4 text-xs text-gray-500 mb-3 flex-wrap">
                            <a href="mailto:{{ req.clientEmail }}" class="hover:text-white transition-colors">{{ req.clientEmail }}</a>
                            {% if req.clientPhone %}<span>{{ req.clientPhone }}</span>{% endif %}
                            <span>{{ req.createdAt | date('d/m/Y à H:i') }}</span>
                        </div>
                        {% if services[req.serviceId] is defined %}
                            <p class="text-xs text-gray-400 mb-2">Service : <span class="text-white">{{ services[req.serviceId] }}</span></p>
                        {% endif %}
                        {% if req.totalEstimated > 0 %}
                            <p class="text-xs text-gray-400 mb-3">Estimation : <span class="font-bold" style="color: #C5A059;">{{ req.totalEstimated | number_format(0, ',', ' ') }} €</span></p>
                        {% endif %}
                        {% if req.message %}
                            <div class="rounded-lg px-4 py-3 border border-gray-700 text-gray-300 text-sm leading-relaxed" style="background-color: #111;">
                                {{ req.message | nl2br }}
                            </div>
                        {% endif %}
                    </div>
                    <div class="flex flex-col gap-2">
                        <a href="mailto:{{ req.clientEmail }}"
                           class="px-4 py-2 text-xs font-semibold rounded transition-colors text-center border"
                           style="border-color: #C5A059; color: #C5A059;"
                           onmouseover="this.style.background='#C5A059';this.style.color='#0a0a0a'"
                           onmouseout="this.style.background='transparent';this.style.color='#C5A059'">
                            Répondre
                        </a>
                        {% if req.status == 'en_attente' %}
                            <a href="{{ path('app_admin_devis') }}"
                               class="px-4 py-2 text-xs font-semibold rounded transition-colors text-center border border-gray-600 text-gray-400 hover:text-white hover:border-gray-400">
                                Gérer
                            </a>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endfor %}
    {% endif %}
</div>

{% endblock %}
