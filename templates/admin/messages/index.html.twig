{% extends 'admin/base.html.twig' %}
{% block title %}Messages — Backoffice{% endblock %}
{% block page_title %}Messages clients{% endblock %}

{% block content %}

{# ════ ONGLETS ════ #}
<div style="display:flex;gap:8px;margin-bottom:24px;" class="a-reveal">
    <button id="tab-devis" onclick="switchTab('devis')"
            style="padding:7px 16px;border-radius:7px;font-size:13px;font-weight:500;cursor:pointer;border:1px solid #C5A059;background:#C5A059;color:#0a0a0a;">
        Demandes de devis
        <span style="margin-left:6px;padding:1px 6px;border-radius:20px;font-size:10px;background:rgba(0,0,0,.2);">{{ requests|length }}</span>
    </button>
    <button id="tab-contact" onclick="switchTab('contact')"
            style="padding:7px 16px;border-radius:7px;font-size:13px;font-weight:500;cursor:pointer;border:1px solid hsl(0 0% 14%);background:transparent;color:hsl(0 0% 55%);">
        Messages contact
        <span style="margin-left:6px;padding:1px 6px;border-radius:20px;font-size:10px;background:hsl(0 0% 10%);color:hsl(0 0% 45%);">{{ contacts|length }}</span>
    </button>
</div>

{# ════ SECTION DEVIS ════ #}
<div id="section-devis">

{% if requests is empty %}
<div class="admin-card a-reveal" style="text-align:center;padding:60px;font-size:13px;color:hsl(0 0% 35%);font-style:italic;">
    Aucune demande de devis reçue.
</div>
{% else %}
<div style="display:flex;flex-direction:column;gap:12px;">
    {% for req in requests %}
    <div class="admin-card a-reveal" style="padding:20px;">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;flex-wrap:wrap;">

            <div style="flex:1;min-width:0;">
                <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:6px;">
                    <span style="font-size:14px;font-weight:600;color:#e5e5e5;">{{ req.clientName }}</span>

                    {% if req.status == 'en_attente' %}
                    <span style="padding:2px 8px;border-radius:20px;font-size:10.5px;font-weight:600;background:hsl(48 60% 10%);color:hsl(48 80% 65%);border:1px solid hsl(48 60% 18%);white-space:nowrap;">En attente</span>
                    {% elseif req.status == 'accepte' %}
                    <span style="padding:2px 8px;border-radius:20px;font-size:10.5px;font-weight:600;background:hsl(142 40% 8%);color:hsl(142 55% 58%);border:1px solid hsl(142 40% 16%);">Accepté</span>
                    {% else %}
                    <span style="padding:2px 8px;border-radius:20px;font-size:10.5px;font-weight:600;background:hsl(0 40% 8%);color:hsl(0 55% 58%);border:1px solid hsl(0 40% 16%);">Refusé</span>
                    {% endif %}
                </div>

                <div style="display:flex;gap:16px;flex-wrap:wrap;margin-bottom:12px;">
                    <a href="mailto:{{ req.clientEmail }}"
                       style="font-size:12px;color:hsl(0 0% 50%);text-decoration:none;transition:color .15s;"
                       onmouseover="this.style.color='#C5A059'" onmouseout="this.style.color='hsl(0 0% 50%)'">
                        {{ req.clientEmail }}
                    </a>
                    {% if req.clientPhone %}
                    <span style="font-size:12px;color:hsl(0 0% 45%);">{{ req.clientPhone }}</span>
                    {% endif %}
                    <span style="font-size:12px;color:hsl(0 0% 38%);">{{ req.createdAt|date('d/m/Y à H:i') }}</span>
                </div>

                <div style="display:flex;gap:20px;flex-wrap:wrap;margin-bottom:{% if req.message %}12px{% else %}0{% endif %};">
                    {% if services[req.serviceId] is defined %}
                    <p style="font-size:12px;color:hsl(0 0% 42%);">
                        Service : <span style="color:#e5e5e5;font-weight:500;">{{ services[req.serviceId] }}</span>
                    </p>
                    {% endif %}
                    {% if req.totalEstimated > 0 %}
                    <p style="font-size:12px;color:hsl(0 0% 42%);">
                        Estimation : <span style="font-weight:700;color:#C5A059;">{{ req.totalEstimated|number_format(0, ',', ' ') }} €</span>
                    </p>
                    {% endif %}
                </div>

                {% if req.message %}
                <div style="padding:12px 16px;background:hsl(0 0% 5%);border:1px solid hsl(0 0% 10%);border-radius:8px;font-size:13px;color:hsl(0 0% 65%);line-height:1.6;">
                    {{ req.message|nl2br }}
                </div>
                {% endif %}
            </div>

            <div style="display:flex;flex-direction:column;gap:8px;flex-shrink:0;">
                <a href="mailto:{{ req.clientEmail }}" class="btn-gold" style="font-size:11px;padding:7px 14px;text-align:center;">
                    Répondre
                </a>
                {% if req.status == 'en_attente' %}
                <a href="{{ path('app_admin_devis') }}" data-turbo="false" class="btn-ghost" style="font-size:11px;padding:7px 14px;text-align:center;">
                    Voir devis
                </a>
                {% endif %}
            </div>
        </div>
    </div>
    {% endfor %}
</div>
{% endif %}

</div>

{# ════ SECTION CONTACT ════ #}
<div id="section-contact" style="display:none;">

{% if contacts is empty %}
<div class="admin-card a-reveal" style="text-align:center;padding:60px;font-size:13px;color:hsl(0 0% 35%);font-style:italic;">
    Aucun message de contact reçu.
</div>
{% else %}
<div style="display:flex;flex-direction:column;gap:12px;">
    {% for msg in contacts %}
    <div class="admin-card a-reveal" style="padding:20px;">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;flex-wrap:wrap;">

            <div style="flex:1;min-width:0;">
                <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:6px;">
                    <span style="font-size:14px;font-weight:600;color:#e5e5e5;">{{ msg.name }}</span>
                    <span style="padding:2px 8px;border-radius:20px;font-size:10.5px;font-weight:600;background:hsl(220 40% 8%);color:hsl(220 55% 65%);border:1px solid hsl(220 40% 16%);">Contact</span>
                </div>

                <div style="display:flex;gap:16px;flex-wrap:wrap;margin-bottom:12px;">
                    <a href="mailto:{{ msg.email }}"
                       style="font-size:12px;color:hsl(0 0% 50%);text-decoration:none;transition:color .15s;"
                       onmouseover="this.style.color='#C5A059'" onmouseout="this.style.color='hsl(0 0% 50%)'">
                        {{ msg.email }}
                    </a>
                    <span style="font-size:12px;color:hsl(0 0% 38%);">{{ msg.createdAt|date('d/m/Y à H:i') }}</span>
                </div>

                <div style="padding:12px 16px;background:hsl(0 0% 5%);border:1px solid hsl(0 0% 10%);border-radius:8px;font-size:13px;color:hsl(0 0% 65%);line-height:1.6;">
                    {{ msg.message|nl2br }}
                </div>
            </div>

            <div style="flex-shrink:0;">
                <a href="mailto:{{ msg.email }}" class="btn-gold" style="font-size:11px;padding:7px 14px;">
                    Répondre
                </a>
            </div>
        </div>
    </div>
    {% endfor %}
</div>
{% endif %}

</div>

<script>
function switchTab(tab) {
    const isDevis = tab === 'devis';
    document.getElementById('section-devis').style.display   = isDevis ? '' : 'none';
    document.getElementById('section-contact').style.display = isDevis ? 'none' : '';

    const active = 'border:1px solid #C5A059;background:#C5A059;color:#0a0a0a;';
    const idle   = 'border:1px solid hsl(0 0% 14%);background:transparent;color:hsl(0 0% 55%);';

    document.getElementById('tab-devis').style.cssText   = 'padding:7px 16px;border-radius:7px;font-size:13px;font-weight:500;cursor:pointer;' + (isDevis ? active : idle);
    document.getElementById('tab-contact').style.cssText = 'padding:7px 16px;border-radius:7px;font-size:13px;font-weight:500;cursor:pointer;' + (!isDevis ? active : idle);
}
</script>

{% endblock %}
