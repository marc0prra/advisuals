{% extends 'base.html.twig' %}

{% block title %}Simulateur de devis — Adrien Mihajlovic{% endblock %}

{% block body %}

{# Hero #}
<section class="pt-40 pb-20 border-b" style="background-color: #0a0a0a; border-color: rgba(255,255,255,0.06);">
    <div class="max-w-4xl mx-auto px-6">
        <span class="section-label">Devis gratuit</span>
        <h1 class="font-serif font-light text-white mb-4" style="font-size: clamp(2.5rem, 6vw, 4.5rem); line-height: 1.05;">
            Simulez votre projet
        </h1>
        <p class="text-sm" style="color: #6b7280;">
            Estimation immédiate — gratuite &amp; sans engagement.
        </p>
    </div>
</section>

{# Simulateur #}
<section class="py-20" style="background-color: #0a0a0a;">
    <div class="max-w-4xl mx-auto px-6" data-controller="quote-simulator">

        {% for flash_message in app.flashes('devis_success') %}
            <div class="mb-8 px-5 py-4 text-sm border" role="alert"
                 style="background-color: #0f1a0f; border-color: rgba(74,222,128,0.2); color: #86efac;">
                {{ flash_message }}
            </div>
        {% endfor %}

        {# Card principale #}
        <div class="border" style="background-color: #0f0f0f; border-color: rgba(255,255,255,0.07);">
            <div class="p-8 md:p-12">

                {# Sélecteur service #}
                <div class="mb-10">
                    <label for="service-select" class="form-label">Type de prestation</label>
                    <select
                        id="service-select"
                        data-quote-simulator-target="service"
                        data-action="change->quote-simulator#calculate"
                        class="form-input font-serif font-light text-base"
                        style="background-color: transparent;"
                    >
                        <option value="" style="background-color: #0f0f0f;">Choisissez un service</option>
                        {% for service in services %}
                            <option value="{{ service.basePrice }}" style="background-color: #0f0f0f;">
                                {{ service.label }} — à partir de {{ service.basePrice }}€
                            </option>
                        {% endfor %}
                    </select>
                </div>

                {# Sélecteur durée #}
                <div class="mb-10">
                    <label for="duration-select" class="form-label">Durée estimée</label>
                    <select
                        id="duration-select"
                        data-quote-simulator-target="duration"
                        data-action="change->quote-simulator#calculate"
                        class="form-input font-serif font-light text-base"
                        style="background-color: transparent;"
                    >
                        <option value="" style="background-color: #0f0f0f;">Choisissez une durée</option>
                        <option value="1"   style="background-color: #0f0f0f;">2 heures — Standard</option>
                        <option value="1.6" style="background-color: #0f0f0f;">4 heures — Demi-journée</option>
                        <option value="2.8" style="background-color: #0f0f0f;">Journée complète</option>
                        <option value="4"   style="background-color: #0f0f0f;">Plusieurs jours</option>
                    </select>
                </div>

                {# Bouton calculer #}
                <button
                    data-action="click->quote-simulator#calculate"
                    class="btn-primary w-full">
                    Calculer l'estimation
                </button>

                {# Résultat #}
                <div data-quote-simulator-target="resultContainer"
                     class="hidden mt-10 pt-10 border-t text-center"
                     style="border-color: rgba(255,255,255,0.06);">
                    <p class="text-xs uppercase tracking-widest mb-3" style="color: #6b7280;">Estimation indicative</p>
                    <p class="font-serif text-6xl font-light mb-3" style="color: #C5A059;">
                        <span data-quote-simulator-target="price">0</span>
                    </p>
                    <p class="text-xs italic" style="color: #4b5563;">
                        Prix indicatif, sujet à ajustement selon vos besoins spécifiques.
                    </p>
                </div>

            </div>

            {# Formulaire de demande #}
            <div data-quote-simulator-target="formContainer"
                 class="hidden border-t px-8 md:px-12 py-10"
                 style="border-color: rgba(255,255,255,0.06);">

                <h2 class="font-serif text-2xl font-light text-white mb-8">
                    Envoyer ma demande
                </h2>

                <form method="post" action="{{ path('devis_submit') }}" class="space-y-8" novalidate>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('devis') }}">
                    <input type="hidden" name="service_id"      data-quote-simulator-target="serviceIdField" value="">
                    <input type="hidden" name="total_estimated"  data-quote-simulator-target="totalField" value="">

                    <div class="grid sm:grid-cols-2 gap-8">
                        <div>
                            <label for="client-name" class="form-label">
                                Nom complet <span style="color: #C5A059;" aria-label="requis">*</span>
                            </label>
                            <input
                                type="text"
                                id="client-name"
                                name="client_name"
                                required
                                autocomplete="name"
                                placeholder="Jean Dupont"
                                class="form-input"
                            >
                        </div>
                        <div>
                            <label for="client-email" class="form-label">
                                Email <span style="color: #C5A059;" aria-label="requis">*</span>
                            </label>
                            <input
                                type="email"
                                id="client-email"
                                name="client_email"
                                required
                                autocomplete="email"
                                placeholder="jean@exemple.fr"
                                class="form-input"
                            >
                        </div>
                    </div>

                    <div>
                        <label for="client-phone" class="form-label">Téléphone (optionnel)</label>
                        <input
                            type="tel"
                            id="client-phone"
                            name="client_phone"
                            autocomplete="tel"
                            placeholder="06 00 00 00 00"
                            class="form-input"
                        >
                    </div>

                    <div>
                        <label for="client-message" class="form-label">
                            Décrivez votre projet <span style="color: #C5A059;" aria-label="requis">*</span>
                        </label>
                        <textarea
                            id="client-message"
                            name="message"
                            required
                            rows="4"
                            placeholder="Vision, contexte, dates souhaitées..."
                            class="form-input resize-none"
                        ></textarea>
                    </div>

                    <button type="submit" class="btn-primary w-full">
                        Envoyer la demande
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                        </svg>
                    </button>
                </form>
            </div>
        </div>

        {# Note bas de page #}
        <div class="mt-12 text-center">
            <p class="text-xs mb-3" style="color: #4b5563;">
                Une question ? Contactez directement par email.
            </p>
            <a href="mailto:adrienmihajlovic.pro@gmail.com"
               class="text-xs transition-colors hover:text-white"
               style="color: #C5A059;">
                adrienmihajlovic.pro@gmail.com
            </a>
        </div>

    </div>
</section>

{% endblock %}
