{# templates/devis/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Simuler un devis | Ad Visuals{% endblock %}

{% block body %}
    <section class="pt-32 pb-24 bg-gradient-to-b from-[#0d0d0d] to-[#0a0a0a]">
        <div class="container mx-auto px-4 max-w-4xl" data-controller="quote-simulator">
            
            {# En-tête (Maquette: QuoteSimulator.tsx header) #}
            <div class="text-center mb-16">
                <h1 class="font-serif text-4xl sm:text-5xl font-light mb-4 text-white">Simulateur de Devis</h1>
                <p class="text-gray-400 leading-relaxed max-w-2xl mx-auto">
                    Obtenez une estimation immédiate de votre projet photographique
                </p>
                <p class="text-xs text-[#C5A059] mt-3 italic tracking-widest uppercase">
                    L'établissement d'un devis personnalisé est entièrement gratuit
                </p>
            </div>

            {# Card Simulateur (Maquette: Card component) #}
            <div class="bg-[#0d0d0d] p-8 sm:p-12 border border-white/5 shadow-2xl relative overflow-hidden">
                {# Ornement discret #}
                <div class="absolute top-0 right-0 w-32 h-32 bg-[#C5A059]/5 blur-3xl rounded-full -mr-16 -mt-16"></div>

                <div class="grid gap-10 relative z-10">
                    {# Sélection du service #}
                    <div class="space-y-4">
                        <label class="block text-xs uppercase tracking-[0.2em] text-gray-500 font-medium">Type de prestation</label>
                        <select 
                            data-quote-simulator-target="service" 
                            data-action="change->quote-simulator#calculate" 
                            class="w-full bg-transparent border-b border-white/10 py-4 text-lg font-serif italic outline-none focus:border-[#C5A059] transition-colors appearance-none cursor-pointer"
                        >
                            <option value="" class="bg-[#0a0a0a]">Sélectionnez un type de service</option>
                            {% for service in services %}
                                <option value="{{ service.basePrice }}" class="bg-[#0a0a0a]">
                                    {{ service.label }} (Base: {{ service.basePrice }}€)
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    {# Sélection de la durée #}
                    <div class="space-y-4">
                        <label class="block text-xs uppercase tracking-[0.2em] text-gray-500 font-medium">Durée estimée</label>
                        <select 
                            data-quote-simulator-target="duration" 
                            data-action="change->quote-simulator#calculate" 
                            class="w-full bg-transparent border-b border-white/10 py-4 text-lg font-serif italic outline-none focus:border-[#C5A059] transition-colors appearance-none cursor-pointer"
                        >
                            <option value="" class="bg-[#0a0a0a]">Sélectionnez une durée</option>
                            <option value="1" class="bg-[#0a0a0a]">2 heures (Standard)</option>
                            <option value="1.6" class="bg-[#0a0a0a]">4 heures (Demi-journée)</option>
                            <option value="2.8" class="bg-[#0a0a0a]">Journée complète</option>
                            <option value="4" class="bg-[#0a0a0a]">Plusieurs jours</option>
                        </select>
                    </div>

                    {# Résultat (Maquette: Estimated price block) #}
                    <div data-quote-simulator-target="resultContainer" class="hidden mt-6 p-8 bg-[#C5A059]/5 border border-[#C5A059]/20 text-center group">
                        <p class="text-[10px] uppercase tracking-[0.3em] text-gray-500 mb-2">Estimation indicative</p>
                        <p class="font-serif text-5xl font-semibold text-[#C5A059] mb-3" data-quote-simulator-target="price">0€</p>
                        <p class="text-[10px] text-gray-600 italic">
                            *Prix indicatif, sujet à ajustements selon les besoins spécifiques
                        </p>
                    </div>

                    {# Bouton pour révéler le formulaire (si non automatique) #}
                    <div class="pt-4 text-center">
                         <button 
                            data-action="click->quote-simulator#calculate"
                            class="w-full sm:w-auto px-12 py-4 bg-[#C5A059] text-black font-bold uppercase text-xs tracking-[0.2em] hover:bg-white transition-all duration-300"
                        >
                            Calculer l'estimation
                        </button>
                    </div>
                    
                    {# Formulaire de contact (Maquette: Contact Form section) #}
                    <div data-quote-simulator-target="formContainer" class="hidden mt-12 pt-12 border-t border-white/5 animate-in fade-in slide-in-from-bottom-4 duration-700">
                         <h3 class="font-serif text-3xl font-light mb-8 text-white">Demander un devis personnalisé</h3>
                         
                         <form class="grid gap-8">
                            <div class="grid sm:grid-cols-2 gap-8">
                                <div class="space-y-2">
                                    <label class="text-[10px] uppercase tracking-widest text-gray-500">Nom complet</label>
                                    <input type="text" placeholder="Jean Dupont" class="w-full bg-transparent border-b border-white/10 py-3 outline-none focus:border-[#C5A059] text-sm">
                                </div>
                                <div class="space-y-2">
                                    <label class="text-[10px] uppercase tracking-widest text-gray-500">Email</label>
                                    <input type="email" placeholder="jean@exemple.fr" class="w-full bg-transparent border-b border-white/10 py-3 outline-none focus:border-[#C5A059] text-sm">
                                </div>
                            </div>
                            <div class="space-y-2">
                                <label class="text-[10px] uppercase tracking-widest text-gray-500">Détails du projet</label>
                                <textarea rows="4" placeholder="Décrivez votre vision, dates souhaitées..." class="w-full bg-transparent border-b border-white/10 py-3 outline-none focus:border-[#C5A059] text-sm resize-none"></textarea>
                            </div>
                            <button type="submit" class="w-full py-4 border border-white/20 uppercase text-[10px] tracking-[0.3em] font-bold hover:bg-white hover:text-black transition-all">
                                Envoyer la demande
                            </button>
                         </form>
                    </div>
                </div>
            </div>

            {# Support (Maquette: Footer info) #}
            <div class="mt-16 text-center">
                <p class="text-sm text-gray-500 mb-4">Besoin d'informations complémentaires ?</p>
                <a href="mailto:adrienmihajlovic.pro@gmail.com" class="text-[#C5A059] hover:text-white transition-colors flex items-center justify-center gap-2 text-sm font-medium">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                    adrienmihajlovic.pro@gmail.com
                </a>
            </div>
        </div>
    </section>
{% endblock %}