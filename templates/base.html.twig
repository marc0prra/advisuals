{# templates/base.html.twig #}
<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Ad Visuals | Photographe{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        
        {# Polices : Poppins + Playfair Display #}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Poppins:wght@100;300;400;500;600;700&display=swap" rel="stylesheet">

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}

        {% block javascripts %}
            {{ importmap('app') }}
        {% endblock %}
    </head>

    <body class="bg-[#0a0a0a] text-white font-['Poppins']">
        
        {# NAVIGATION #}
        <nav class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-black/80 backdrop-blur-md border-b border-white/5">
            <div class="container mx-auto px-4 h-20 flex items-center justify-between">
                <a href="{{ path('home') }}" class="font-serif text-2xl font-semibold tracking-tight">AM</a>
                
                <div class="hidden md:flex items-center gap-8 text-sm uppercase tracking-widest text-gray-400">
                    <a href="{{ path('home') }}" class="hover:text-[#C5A059] transition-colors">Accueil</a>
                    <a href="{{ path('about') }}" class="hover:text-[#C5A059] transition-colors">À propos</a>
                    <a href="{{ path('services') }}" class="hover:text-[#C5A059] transition-colors">Services</a>
                    <a href="{{ path('portfolio') }}" class="hover:text-[#C5A059] transition-colors">Portfolio</a>
                    <a href="{{ path('devis') }}" class="border border-[#C5A059] text-[#C5A059] px-5 py-2 hover:bg-[#C5A059] hover:text-black transition-all">
                        Demander un devis
                    </a>
                </div>
            </div>
        </nav>

        <main>
            {# ZONE DES MESSAGES FLASH #}
            <div class="fixed top-24 right-6 z-[60] space-y-4">
                {% for message in app.flashes('success') %}
                    <div class="p-4 text-sm text-green-400 bg-green-900/20 border border-green-500/50 rounded-lg">
                        <span class="font-bold">Succès :</span> {{ message }}
                    </div>
                {% endfor %}
                {% for message in app.flashes('error') %}
                    <div class="p-4 text-sm text-red-400 bg-red-900/20 border border-red-500/50 rounded-lg">
                        <span class="font-bold">Erreur :</span> {{ message }}
                    </div>
                {% endfor %}
            </div>

            {% block body %}{% endblock %}
        </main>

        {# FOOTER #}
        <footer class="bg-[#050505] border-t border-white/5 py-16">
            <div class="container mx-auto px-4 grid md:grid-cols-3 gap-12 max-w-6xl">
                <div>
                    <h3 class="font-serif text-2xl font-semibold mb-4 italic">Adrien Mihajlovic</h3>
                    <p class="text-sm text-gray-500 leading-relaxed">Photographe professionnel spécialisé en portraits, reportages et photographie commerciale.</p>
                </div>
                <div>
                    <h4 class="font-semibold mb-4 text-[#C5A059]">Navigation</h4>
                    <ul class="space-y-2 text-sm text-gray-500">
                        <li><a href="{{ path('portfolio') }}" class="hover:text-white transition-colors">Portfolio</a></li>
                        <li><a href="{{ path('services') }}" class="hover:text-white transition-colors">Services</a></li>
                        <li><a href="{{ path('contact') }}" class="hover:text-white transition-colors">Contact</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="font-semibold mb-4 text-[#C5A059]">Contact</h4>
                    <p class="text-sm text-gray-500">adrienmihajlovic.pro@gmail.com</p>
                    <p class="text-sm text-gray-500 mt-2">Instagram : @advisuals</p>
                </div>
            </div>
            <div class="text-center mt-12 pt-8 border-t border-white/5 text-xs text-gray-600">
                &copy; {{ "now"|date('Y') }} Adrien Mihajlovic. Tous droits réservés.
            </div>
        </footer>
    </body>
</html>