{% extends 'base.html.twig' %}

{% block title %}Contact — AD Visuals{% endblock %}

{% block body %}

{# Hero #}
<section class="pt-32 pb-16 px-4" style="background: linear-gradient(180deg, #111 0%, #0a0a0a 100%);">
    <div class="max-w-3xl mx-auto text-center">
        <p class="text-xs tracking-widest uppercase mb-4" style="color: #C5A059;">Parlons de votre projet</p>
        <h1 class="font-serif text-4xl md:text-5xl font-bold text-white mb-6">Contact</h1>
        <p class="text-gray-400 text-lg leading-relaxed">
            Un projet en tête ? Une question sur mes services ? Je vous réponds sous 24h.
        </p>
    </div>
</section>

{# Contenu #}
<section class="py-20 px-4" style="background-color: #0a0a0a;">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-16">

        {# Infos de contact #}
        <div class="space-y-10">
            <div>
                <h2 class="font-serif text-2xl text-white mb-6">Restons en contact</h2>
                <p class="text-gray-400 leading-relaxed">
                    Que ce soit pour un shooting studio, une campagne commerciale ou un reportage,
                    je suis disponible pour discuter de votre vision et construire ensemble quelque chose d'exceptionnel.
                </p>
            </div>

            <div class="space-y-6">
                <div class="flex items-start gap-4">
                    <div class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 mt-1" style="background-color: #1a1a1a; border: 1px solid #333;">
                        <svg class="w-4 h-4" style="color: #C5A059;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                        </svg>
                    </div>
                    <div>
                        <p class="text-xs tracking-widest uppercase text-gray-500 mb-1">Email</p>
                        <a href="mailto:adrienmihajlovic.pro@gmail.com" class="text-white hover:underline" style="text-decoration-color: #C5A059;">
                            adrienmihajlovic.pro@gmail.com
                        </a>
                    </div>
                </div>

                <div class="flex items-start gap-4">
                    <div class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 mt-1" style="background-color: #1a1a1a; border: 1px solid #333;">
                        <svg class="w-4 h-4" style="color: #C5A059;" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                        </svg>
                    </div>
                    <div>
                        <p class="text-xs tracking-widest uppercase text-gray-500 mb-1">Instagram</p>
                        <a href="https://instagram.com/adrien.mihajlovic" target="_blank" rel="noopener" class="text-white hover:underline" style="text-decoration-color: #C5A059;">
                            @adrien.mihajlovic
                        </a>
                    </div>
                </div>

                <div class="flex items-start gap-4">
                    <div class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 mt-1" style="background-color: #1a1a1a; border: 1px solid #333;">
                        <svg class="w-4 h-4" style="color: #C5A059;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                        </svg>
                    </div>
                    <div>
                        <p class="text-xs tracking-widest uppercase text-gray-500 mb-1">Localisation</p>
                        <p class="text-white">Paris, France</p>
                        <p class="text-gray-500 text-sm">Déplacements possibles partout en France</p>
                    </div>
                </div>
            </div>

            <div class="pt-6 border-t border-gray-800">
                <a href="{{ path('devis') }}"
                   class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-semibold text-sm tracking-widest uppercase transition-all duration-300 hover:opacity-90"
                   style="background-color: #C5A059; color: #0a0a0a;">
                    Demander un devis
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                    </svg>
                </a>
            </div>
        </div>

        {# Formulaire simple #}
        <div class="rounded-2xl p-8 border border-gray-800" style="background-color: #0d0d0d;">
            <h2 class="font-serif text-xl text-white mb-6">Envoyer un message</h2>

            {% for flash_message in app.flashes('contact_success') %}
                <div class="mb-6 px-4 py-3 rounded border border-green-700 bg-green-900/30 text-green-300 text-sm">
                    {{ flash_message }}
                </div>
            {% endfor %}

            <form method="post" action="{{ path('contact') }}" class="space-y-5">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('contact') }}">

                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">Votre nom</label>
                    <input
                        type="text"
                        name="name"
                        required
                        class="w-full px-4 py-3 rounded-lg text-white placeholder-gray-600 border border-gray-700 focus:border-yellow-600 focus:outline-none transition-colors"
                        style="background-color: #1a1a1a;"
                        placeholder="Jean Dupont"
                    >
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">Email</label>
                    <input
                        type="email"
                        name="email"
                        required
                        class="w-full px-4 py-3 rounded-lg text-white placeholder-gray-600 border border-gray-700 focus:border-yellow-600 focus:outline-none transition-colors"
                        style="background-color: #1a1a1a;"
                        placeholder="jean@exemple.com"
                    >
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">Message</label>
                    <textarea
                        name="message"
                        required
                        rows="5"
                        class="w-full px-4 py-3 rounded-lg text-white placeholder-gray-600 border border-gray-700 focus:border-yellow-600 focus:outline-none transition-colors resize-none"
                        style="background-color: #1a1a1a;"
                        placeholder="Décrivez votre projet..."
                    ></textarea>
                </div>

                <button
                    type="submit"
                    class="w-full py-3 px-6 rounded-lg font-semibold text-sm tracking-widest uppercase transition-all duration-300 hover:opacity-90"
                    style="background-color: #C5A059; color: #0a0a0a;"
                >
                    Envoyer
                </button>
            </form>
        </div>

    </div>
</section>

{% endblock %}
