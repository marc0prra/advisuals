{% extends 'base.html.twig' %}

{% block title %}Services — Adrien Mihajlovic{% endblock %}

{% block body %}

{# Hero #}
<section class="pt-40 pb-20 border-b" style="background-color: #0a0a0a; border-color: rgba(255,255,255,0.06);">
    <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row md:items-end justify-between gap-8">
        <div>
            <span class="section-label">Ce que je propose</span>
            <h1 class="font-serif font-light text-white" style="font-size: clamp(2.5rem, 6vw, 5rem); line-height: 1.05;">
                Services
            </h1>
        </div>
        <p class="text-sm max-w-xs text-right" style="color: #6b7280;">
            Devis gratuit et personnalisé.<br>Réponse garantie sous 24h.
        </p>
    </div>
</section>

{# Services list #}
<section class="py-4" style="background-color: #0a0a0a;">
    <div class="max-w-7xl mx-auto px-6">
        {% for service in services %}
            <article class="py-16 border-b" style="border-color: rgba(255,255,255,0.06);">
                <div class="grid lg:grid-cols-12 gap-12">

                    {# Numéro + titre + prix #}
                    <div class="lg:col-span-4">
                        <p class="font-serif text-6xl font-light mb-6" style="color: rgba(255,255,255,0.07);" aria-hidden="true">
                            0{{ loop.index }}
                        </p>
                        <h2 class="font-serif text-2xl text-white mb-4">{{ service.label }}</h2>
                        <p class="text-3xl font-light" style="color: #C5A059;">
                            {{ service.basePrice|number_format(0, ',', ' ') }} €
                            <span class="text-sm font-normal" style="color: #6b7280;">de base</span>
                        </p>
                    </div>

                    {# Description + inclusions #}
                    <div class="lg:col-span-5">
                        <p class="text-sm leading-relaxed mb-8 italic" style="color: #9ca3af;">
                            {{ service.description }}
                        </p>
                        <div>
                            <p class="text-xs uppercase tracking-widest mb-4" style="color: #C5A059;">Ce qui est inclus</p>
                            <ul class="space-y-3 text-sm" style="color: #9ca3af;">
                                <li class="flex items-start gap-3">
                                    <span class="mt-0.5 flex-shrink-0" style="color: #C5A059;" aria-hidden="true">—</span>
                                    Consultation préalable pour définir votre vision
                                </li>
                                <li class="flex items-start gap-3">
                                    <span class="mt-0.5 flex-shrink-0" style="color: #C5A059;" aria-hidden="true">—</span>
                                    Post-production professionnelle
                                </li>
                                <li class="flex items-start gap-3">
                                    <span class="mt-0.5 flex-shrink-0" style="color: #C5A059;" aria-hidden="true">—</span>
                                    Livraison haute résolution via galerie privée
                                </li>
                            </ul>
                        </div>
                    </div>

                    {# CTA #}
                    <div class="lg:col-span-3 flex flex-col justify-between items-start lg:items-end">
                        <div class="text-right hidden lg:block">
                            <p class="text-xs mb-1" style="color: #6b7280;">Catégorie</p>
                            <p class="text-xs uppercase tracking-widest text-white">{{ service.category }}</p>
                        </div>
                        <a href="{{ path('devis') }}" class="btn-primary mt-6 lg:mt-0">
                            Demander un devis
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                            </svg>
                        </a>
                    </div>
                </div>
            </article>
        {% else %}
            <div class="py-20 text-center border-b" style="border-color: rgba(255,255,255,0.06);">
                <p class="text-sm italic" style="color: #6b7280;">Aucun service configuré pour le moment.</p>
            </div>
        {% endfor %}
    </div>
</section>

{# Infos pratiques #}
<section class="py-24 border-t" style="background-color: #080808; border-color: rgba(255,255,255,0.06);">
    <div class="max-w-7xl mx-auto px-6">
        <span class="section-label">Avant de commencer</span>
        <h2 class="font-serif font-light text-white mb-16" style="font-size: 2rem;">Informations pratiques</h2>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-px" style="background-color: rgba(255,255,255,0.06);">

            {% for info in practicalInfos %}
            <div class="service-card reveal reveal-delay-{{ loop.index }}">
                <p class="text-xs uppercase tracking-widest mb-6" style="color: #C5A059;">{{ info.label }}</p>
                <p class="text-sm font-medium text-white mb-2">{{ info.title }}</p>
                <p class="text-xs leading-relaxed" style="color: #6b7280;">{{ info.description }}</p>
            </div>
            {% else %}
            <div class="col-span-4 py-10 text-center text-gray-600 italic text-sm">Aucune information pratique configurée.</div>
            {% endfor %}

        </div>
    </div>
</section>

{% endblock %}
